# Copy this file to docker/backend.env and set a unique password.
ZAPARA_DB_NAME=shared
ZAPARA_DB_USER=zapara
ZAPARA_DB_PASSWORD=change-me
ZAPARA_DB_HOST=postgres
ZAPARA_DB_PORT=5432

# Set an interval of at least 10 seconds before starting the worker.
# 10 seconds is the minimum; 60 seconds is more conservative.
# ZAPARA_UPSTREAM_INTERVAL_SECONDS=10
